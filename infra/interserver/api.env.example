
# Complete no servidor com sudo nano /opt/ciframais/secrets/api.env.
# Valores vazios sao intencionais: a API recusa iniciar sem configuracao real.
# DATABASE_URL, DIRECT_URL e Redis sao definidos pelo Compose.
FRONTEND_URL=
# Origens HTTPS do frontend separadas por virgula, sem espacos nem barra final.
ALLOWED_ORIGINS=

# Mantenha homologacao e o bloqueio legal ate concluir a configuracao Efi.
EFI_ENV=homologation
EFI_LEGAL_APPROVED=false
# API de abertura de contas (gn.registration.*): desligada ate a Efi liberar.
# Com false, EFI_OPENING_* nao sao exigidas e a ativacao e manual pelo admin.
EFI_OPENING_ENABLED=false
EFI_OPENING_CLIENT_ID=
EFI_OPENING_CLIENT_SECRET=
EFI_OPENING_CERT_PATH=/run/efi/opening.p12
EFI_OPENING_CERT_PASSWORD=
# Conta Efi da CifraMais que recebe a remuneracao por split (obrigatorias).
EFI_PLATFORM_PAYEE_CODE=
EFI_PLATFORM_ACCOUNT_NUMBER=
# CNPJ da CifraMais, 14 digitos.
EFI_PLATFORM_CNPJ=
# Credenciais de API da conta CifraMais: so para os modos de conta CifraMais
# (Fase B). Podem ficar vazias na conta propria do cliente.
EFI_PLATFORM_CLIENT_ID=
EFI_PLATFORM_CLIENT_SECRET=
EFI_PLATFORM_CERT_PATH=
EFI_PLATFORM_CERT_PASSWORD=
# Webhook Pix (mTLS, dominio efi.) e webhook de Cobrancas (boleto/BOLIX).
EFI_WEBHOOK_BASE_URL=
EFI_CHARGES_WEBHOOK_BASE_URL=
# Alertas de certificado das contas dos clientes (30/15/7 dias e vencimento).
PLATFORM_ALERT_EMAIL=

# WhatsApp exclusivamente via Datafy (sem integracao direta com a Meta).
# Token sk_live_ e segredo whsec_ do painel Datafy; URL completa do webhook.
DATAFY_API_TOKEN=
DATAFY_WEBHOOK_SECRET=
# Somente durante a troca do segredo no painel: o segredo antigo, removido depois.
DATAFY_WEBHOOK_SECRET_PREVIOUS=
DATAFY_WEBHOOK_BASE_URL=https://api.ciframais.com.br/webhooks/datafy
# IDs do numero e da WABA (Meta), conferidos contra o /me do Datafy.
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
AUTH_RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Anexos do WhatsApp: volume privado montado pelo compose (nao exposto no Nginx).
COMMUNICATION_MEDIA_DIR=/var/lib/ciframais/communication-media
COMMUNICATION_MEDIA_LIMIT_BYTES=5368709120
