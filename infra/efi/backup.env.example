# Store only on the host, owner root, mode 0600. Never source the API env file.
PGSERVICEFILE=/opt/ciframais/secrets/pg_service.conf
PGSERVICE=ciframais_backup
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_OFFLINE_PUBLIC_RECIPIENT
BACKUP_BUCKET=replace-with-dedicated-unversioned-private-bucket
AWS_REGION=sa-east-1
AWS_SHARED_CREDENTIALS_FILE=/opt/ciframais/secrets/aws-backup-credentials
