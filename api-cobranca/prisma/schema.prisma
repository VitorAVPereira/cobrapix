generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELED
}

enum EfiOnboardingStatus {
  DRAFT
  NOTICE_PENDING
  AWAITING_REPRESENTATIVE
  EFI_PROCESSING
  SUBMISSION_UNCERTAIN
  PROVISIONING
  ACTIVE
  REFUSED
  CORRECTION_REQUIRED
  CONFIGURATION_ERROR
  DISCONNECTED
}

enum EfiEnvironment {
  HOMOLOGATION
  PRODUCTION
}

enum EfiAccountOwnership {
  PLATFORM
  COMPANY
}

enum EfiCredentialStatus {
  CANDIDATE
  ACTIVE
  RETIRED
  REJECTED
}

enum FinancialActivationOrigin {
  AUTOMATIC_OPENING
  MANUAL_ADMIN
}

enum FinancialAccountMode {
  CUSTOMER_ACCOUNT
  PLATFORM_ACCOUNT
}

enum FinancialPayoutMode {
  DIRECT_TO_CUSTOMER
  EFI_SPLIT
  MANUAL
}

enum FinancialProfileStatus {
  DRAFT
  VALIDATING
  READY
  VALIDATION_FAILED
  ACTIVE
  SUPERSEDED
  CANCELED
  EXPIRED
}

enum FinancialAuthorizationKind {
  ACCOUNT_OPENING_CONSENT
  ACCOUNT_INTEGRATION_AUTHORIZATION
  POWER_OF_ATTORNEY
}

enum FinancialValidationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PaymentFeeKind {
  FIXED
  PERCENTAGE
}

enum PaymentChargeStatus {
  DRAFT
  PENDING
  ACTIVE
  PAID
  CANCELED
  EXPIRED
  REPLACED
  FAILED
  REFUNDED
}

enum IntegrationHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

enum PlatformIntegration {
  META
  RESEND
  EFI_ONBOARDING
  EFI_PAYMENTS
  FINANCIAL_MANUAL_ACTIVATION
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
}

enum CommunicationTransport {
  META_DIRECT
  DATAFY
}

enum CommunicationRecipientType {
  PHONE
  BSUID
}

enum CommunicationMessageSource {
  LEGACY
  LIVE
  IMPORTED
}

enum CommunicationAttributionMethod {
  UNASSIGNED
  OUTBOUND_CONTEXT
  REPLY_CONTEXT
  INTERACTIVE_CONTEXT
  MANUAL
}

enum CommunicationDeliveryState {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum CommunicationIntentState {
  PENDING
  SENDING
  ACCEPTED
  FAILED
  UNCERTAIN
}

enum CommunicationActorType {
  SYSTEM
  PLATFORM_ADMIN
}

enum CommunicationAttachmentState {
  PENDING
  READY
  UNAVAILABLE
  EXPIRED
}

enum BusinessSegment {
  GENERAL
  EDUCATION
}

enum PaymentNotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum WhatsappStatus {
  CONNECTED
  DISCONNECTED
  PENDING
}

enum WhatsappProvider {
  META_CLOUD
}

enum WhatsAppTemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

enum BillingMethod {
  PIX
  BOLETO
  BOLIX
}

enum UserRole {
  PLATFORM_ADMIN
  COMPANY_ADMIN
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SplitAppliedCategory {
  ON_TIME
  OVERDUE
}

enum RecurringInvoiceStatus {
  ACTIVE
  PAUSED
}

enum MessagingLimitTier {
  TIER_50
  TIER_250
  TIER_1K
  TIER_10K
  TIER_100K
  TIER_UNLIMITED
}

enum WhatsAppInteractionDirection {
  INBOUND
  OUTBOUND
}

enum CollectionProfileType {
  NEW
  GOOD
  DOUBTFUL
  BAD
}

enum CollectionChannel {
  EMAIL
  WHATSAPP
}

enum CollectionAttemptStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
  OPENED
  CLICKED
}

enum ConversationStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageTemplateCopyCodeSource {
  AUTO
  PIX_COPY_PASTE
  BOLETO_LINE_DIGITABLE
}

model Company {
  id                                    String                   @id @default(uuid())
  corporateName                         String
  tradeName                             String?
  document                              String                   @unique
  email                                 String                   @unique
  phoneNumber                           String
  gatewayToken                          String?
  gatewayProvider                       String                   @default("EFI")
  gatewayAccountId                      String?
  gatewayApiKey                         String?
  gatewayStatus                         String                   @default("PENDING")
  legalRepresentative                   String?
  legalRepresentativeCpf                String?
  legalRepresentativeBirthDate          DateTime?
  addressPostalCode                     String?
  addressStreet                         String?
  addressNumber                         String?
  addressDistrict                       String?
  addressCity                           String?
  addressState                          String?
  bankName                              String?
  bankAgency                            String?
  bankAccount                           String?
  maxDiscountsPerDebtor                 Int                      @default(1)
  discountTriggerDay                    Int                      @default(15)
  collectionReminderDays                Int[]                    @default([0])
  autoGenerateFirstCharge               Boolean                  @default(true)
  autoDiscountEnabled                   Boolean                  @default(false)
  autoDiscountDaysAfterDue              Int?
  autoDiscountPercentage                Decimal?                 @db.Decimal(5, 2)
  preferredBillingMethod                BillingMethod            @default(BOLIX)
  whatsappProvider                      WhatsappProvider         @default(META_CLOUD)
  whatsappInstanceId                    String?
  whatsappStatus                        WhatsappStatus           @default(DISCONNECTED)
  metaPhoneNumberId                     String?
  metaBusinessAccountId                 String?
  metaBusinessPhoneNumber               String?
  metaAccessTokenEncrypted              String?                  @db.Text
  metaDefaultLanguage                   String                   @default("pt_BR")
  messagingLimitTier                    MessagingLimitTier?
  messagingLimitUpdatedAt               DateTime?
  resendApiKeyEncrypted                 String?                  @db.Text
  resendWebhookSecretEncrypted          String?                  @db.Text
  resendFromEmail                       String?
  erpApiKeyHash                         String?
  erpWebhookUrl                         String?
  erpEnabledEvents                      String[]                 @default([])
  businessSegment                       BusinessSegment          @default(GENERAL)
  paymentNotificationEnabled            Boolean                  @default(true)
  paymentNotificationEmails             String[]                 @default([])
  status                                CompanyStatus            @default(ACTIVE)
  enabledBillingMethods                 BillingMethod[]          @default([PIX, BOLIX])
  defaultLateFineBasisPoints            Int                      @default(0)
  defaultLateInterestMonthlyBasisPoints Int                      @default(0)
  defaultPaymentDaysAfterDue            Int                      @default(30)
  activeFinancialProfileId              String?                  @unique
  activeFinancialProfile                FinancialProfileVersion? @relation("CompanyActiveFinancialProfile", fields: [activeFinancialProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  templates             MessageTemplate[]
  emailTemplates        EmailTemplate[]
  templatePreferences   CompanyTemplatePreference[]
  users                 User[]
  debtors               Debtor[]
  invoices              Invoice[]
  paymentNotifications  PaymentNotification[]
  recurringInvoices     RecurringInvoice[]
  collectionLogs        CollectionLog[]
  subscription          Subscription?
  paymentGateway        GatewayAccount?
  originalBankAccount   OriginalBankAccount?
  messagingUsage        MessagingUsage[]
  whatsappInteractions  WhatsAppInteraction[]
  collectionProfiles    CollectionProfile[]
  collectionAttempts    CollectionAttempt[]
  emailEvents           EmailEvent[]
  conversations         WhatsAppConversation[]
  auditLogs             AuditLog[]
  efiOnboarding         EfiOnboarding?
  paymentFeeVersions    PaymentFeeVersion[]
  paymentCharges        PaymentCharge[]
  communicationMessages CommunicationMessage[]
  communicationIntents  CommunicationOutboundIntent[]
  financialProfiles     FinancialProfileVersion[]     @relation("CompanyFinancialProfiles")
  efiAccountIdentities  EfiAccountIdentity[]
  financialValidations  FinancialValidationAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whatsappStatus, whatsappInstanceId])
}

model GatewayAccount {
  id                           String                  @id @default(uuid())
  companyId                    String                  @unique
  company                      Company                 @relation(fields: [companyId], references: [id])
  provider                     String                  @default("EFI")
  environment                  String                  @default("homologation")
  status                       String                  @default("PENDING")
  payeeCode                    String
  efiAccountNumber             String
  efiAccountDigit              String?
  pixKey                       String
  encryptedClientId            String                  @db.Text
  encryptedClientSecret        String                  @db.Text
  encryptedCertificate         String?                 @db.Text
  certificatePath              String?
  encryptedCertificatePassword String?                 @db.Text
  credentialKeyVersion         String                  @default("legacy")
  certificateExpiresAt         DateTime?
  certificateFingerprint       String?
  healthStatus                 IntegrationHealthStatus @default(UNKNOWN)
  lastValidatedAt              DateTime?
  consecutiveFailures          Int                     @default(0)
  lastError                    String?                 @db.Text
  efiAccountIdentityId         String?                 @unique
  efiAccountIdentity           EfiAccountIdentity?     @relation(fields: [efiAccountIdentityId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([efiAccountIdentityId, companyId])
  @@index([companyId])
  @@index([provider, environment])
}

model OriginalBankAccount {
  id             String  @id @default(uuid())
  companyId      String  @unique
  company        Company @relation(fields: [companyId], references: [id])
  holderName     String
  holderDocument String
  bankName       String
  agency         String
  account        String
  accountDigit   String?
  accountType    String  @default("CHECKING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Debtor {
  id                       String             @id @default(uuid())
  companyId                String
  company                  Company            @relation(fields: [companyId], references: [id])
  name                     String
  document                 String?
  phoneNumber              String
  email                    String?
  whatsappOptIn            Boolean            @default(false)
  whatsappOptInAt          DateTime?
  whatsappOptInSource      String?
  gatewayCustomerId        String?
  useGlobalBillingSettings Boolean            @default(true)
  collectionReminderDays   Int[]              @default([])
  autoGenerateFirstCharge  Boolean?
  autoDiscountEnabled      Boolean?
  autoDiscountDaysAfterDue Int?
  autoDiscountPercentage   Decimal?           @db.Decimal(5, 2)
  preferredBillingMethod   BillingMethod?
  collectionProfileId      String?
  collectionProfile        CollectionProfile? @relation(fields: [collectionProfileId], references: [id])
  externalDebtorId         String?

  invoices              Invoice[]
  recurringInvoices     RecurringInvoice[]
  conversations         WhatsAppConversation[]
  communicationMessages CommunicationMessage[]
  communicationIntents  CommunicationOutboundIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, phoneNumber])
  @@unique([companyId, externalDebtorId])
  @@unique([id, companyId])
  @@index([companyId])
}

model Invoice {
  id                 String            @id @default(uuid())
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id])
  debtorId           String
  debtor             Debtor            @relation(fields: [debtorId], references: [id])
  recurringInvoiceId String?
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])

  originalAmount                 Decimal               @db.Decimal(10, 2)
  dueDate                        DateTime
  status                         InvoiceStatus         @default(DRAFT)
  gatewayId                      String?               @unique
  pixPayload                     String?               @db.Text
  pixExpiresAt                   DateTime?
  efiTxid                        String?               @unique
  efiChargeId                    String?               @unique
  efiLocId                       String?
  efiPixCopiaECola               String?               @db.Text
  boletoLinhaDigitavel           String?
  boletoLink                     String?               @db.Text
  boletoPdf                      String?               @db.Text
  splitConfigId                  String?
  notificationToken              String?
  gatewayStatusRaw               String?
  discountApplied                Decimal?              @db.Decimal(10, 2)
  splitAppliedPercentageBps      Int?
  splitAppliedCategory           SplitAppliedCategory?
  billingType                    String                @default("PIX")
  recurrencePeriod               String?
  externalInvoiceId              String?
  externalRef                    String?
  studentName                    String?
  studentEnrollment              String?
  studentGroup                   String?
  paidAt                         DateTime?
  lateFineBasisPoints            Int                   @default(0)
  lateInterestMonthlyBasisPoints Int                   @default(0)
  paymentDaysAfterDue            Int                   @default(30)

  collectionLogs        CollectionLog[]
  collectionAttempts    CollectionAttempt[]
  emailEvents           EmailEvent[]
  paymentNotifications  PaymentNotification[]
  paymentCharges        PaymentCharge[]
  communicationMessages CommunicationMessage[]
  communicationIntents  CommunicationOutboundIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recurringInvoiceId, recurrencePeriod])
  @@unique([companyId, externalInvoiceId])
  @@unique([id, companyId])
  @@index([companyId])
  @@index([debtorId])
  @@index([recurringInvoiceId])
  @@index([companyId, status, dueDate])
  @@index([status, dueDate])
}

model EfiOnboarding {
  id                                String              @id @default(uuid())
  companyId                         String              @unique
  company                           Company             @relation(fields: [companyId], references: [id])
  status                            EfiOnboardingStatus @default(DRAFT)
  simplifiedAccountRequestId        String?             @unique
  submissionIdempotencyKey          String?             @unique
  submissionAttempts                Int                 @default(0)
  noticeAttempts                    Int                 @default(0)
  provisioningAttempts              Int                 @default(0)
  reminderAttempts                  Int                 @default(0)
  lastReminderAt                    DateTime?
  nextReminderAt                    DateTime?
  retryBlockedUntil                 DateTime?
  lastProgressAt                    DateTime            @default(now())
  submittedAt                       DateTime?
  noticeAcceptedAt                  DateTime?
  refusalAt                         DateTime?
  adminAlertedAt                    DateTime?
  activatedAt                       DateTime?
  disconnectedAt                    DateTime?
  sensitiveDataExpiresAt            DateTime?
  sensitiveDataDeletedAt            DateTime?
  sanitizedErrorCode                String?
  sanitizedErrorMessage             String?             @db.Text
  consentAcceptedAt                 DateTime?
  draftRevision                     Int                 @default(0)
  consentDraftRevision              Int?
  consentUserId                     String?
  consentUser                       User?               @relation("EfiOnboardingConsentUser", fields: [consentUserId, companyId], references: [id, companyId], onDelete: Restrict)
  consentIpAddress                  String?
  authorizationTextVersion          String?
  termsVersion                      String?
  privacyPolicyVersion              String?
  submittedCompanyDocument          String?
  provisioningCheckpoint            Json?
  representativeNameEncrypted       String?             @db.Text
  representativeCpfEncrypted        String?             @db.Text
  representativeBirthDateEncrypted  String?             @db.Text
  representativeMotherNameEncrypted String?             @db.Text
  representativeEmailEncrypted      String?             @db.Text
  representativePhoneEncrypted      String?             @db.Text
  sensitiveDataKeyVersion           String?
  createdAt                         DateTime            @default(now())
  updatedAt                         DateTime            @updatedAt

  @@index([status, updatedAt])
  @@index([nextReminderAt])
  @@index([sensitiveDataExpiresAt])
}

model PaymentFeeVersion {
  id                     String          @id @default(uuid())
  companyId              String?
  company                Company?        @relation(fields: [companyId], references: [id])
  scopeKey               String
  billingMethod          BillingMethod
  version                Int
  efiFeeKind             PaymentFeeKind
  efiFeeAmountCents      Int?
  efiFeeBasisPoints      Int?
  platformFeeKind        PaymentFeeKind
  platformFeeAmountCents Int?
  platformFeeBasisPoints Int?
  effectiveFrom          DateTime
  effectiveUntil         DateTime?
  createdByUserId        String?
  createdByUser          User?           @relation("PaymentFeeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt              DateTime        @default(now())
  paymentCharges         PaymentCharge[]

  @@unique([scopeKey, billingMethod, version])
  @@index([companyId, billingMethod, effectiveFrom])
  @@index([scopeKey, billingMethod, effectiveFrom])
}

model PaymentCharge {
  id                             String                       @id @default(uuid())
  companyId                      String
  company                        Company                      @relation(fields: [companyId], references: [id])
  invoiceId                      String
  invoice                        Invoice                      @relation(fields: [invoiceId, companyId], references: [id, companyId])
  feeVersionId                   String
  feeVersion                     PaymentFeeVersion            @relation(fields: [feeVersionId], references: [id])
  replacesChargeId               String?
  replacesCharge                 PaymentCharge?               @relation("ChargeReplacement", fields: [replacesChargeId, companyId, invoiceId], references: [id, companyId, invoiceId])
  replacementCharge              PaymentCharge?               @relation("ChargeReplacement")
  billingMethod                  BillingMethod
  status                         PaymentChargeStatus          @default(DRAFT)
  grossAmountCents               Int
  estimatedEfiFeeCents           Int
  estimatedPlatformFeeCents      Int
  effectiveEfiFeeCents           Int?
  effectivePlatformFeeCents      Int?
  feeSnapshot                    Json
  gatewayId                      String?                      @unique
  efiTxid                        String?                      @unique
  efiChargeId                    String?                      @unique
  efiLocId                       String?
  splitConfigId                  String?
  pixPayload                     String?                      @db.Text
  boletoLine                     String?
  paymentUrl                     String?                      @db.Text
  gatewayStatusRaw               String?
  issuedAt                       DateTime?
  paidAt                         DateTime?
  canceledAt                     DateTime?
  expiresAt                      DateTime?
  paidAmountCents                Int?
  financialProfileId             String?
  financialProfile               FinancialProfileVersion?     @relation(fields: [financialProfileId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  issuerIdentityId               String?
  issuerIdentity                 EfiAccountIdentity?          @relation(fields: [issuerIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuerCredentialVersionId      String?
  issuerCredentialVersion        EfiCredentialVersion?        @relation(fields: [issuerCredentialVersionId, issuerIdentityId], references: [id, identityId], onDelete: Restrict, onUpdate: Restrict)
  accountMode                    FinancialAccountMode?
  payoutMode                     FinancialPayoutMode?
  financialEnvironment           EfiEnvironment?
  distributionSnapshot           Json?
  lateFineBasisPoints            Int?
  lateInterestMonthlyBasisPoints Int?
  paymentDaysAfterDue            Int?
  createdAt                      DateTime                     @default(now())
  updatedAt                      DateTime                     @updatedAt
  statusHistory                  PaymentChargeStatusHistory[]

  @@unique([id, companyId, invoiceId])
  @@unique([replacesChargeId, companyId, invoiceId])
  @@index([companyId, status, createdAt])
  @@index([invoiceId, createdAt])
  @@index([feeVersionId])
  @@index([financialProfileId])
  @@index([issuerIdentityId])
}

model PaymentChargeStatusHistory {
  id               String               @id @default(uuid())
  paymentChargeId  String
  paymentCharge    PaymentCharge        @relation(fields: [paymentChargeId], references: [id], onDelete: Restrict)
  previousStatus   PaymentChargeStatus?
  status           PaymentChargeStatus
  providerStatus   String?
  sanitizedDetails Json?
  occurredAt       DateTime             @default(now())

  @@index([paymentChargeId, occurredAt])
}

// Webhook events that could not be applied safely (unknown charge, receiver
// or account mismatch). Only the reason and a reference are kept; the raw
// payload may contain payer data and is not stored.
model PaymentWebhookAnomaly {
  id                String   @id @default(uuid())
  source            String
  reasonCode        String
  externalReference String
  companyId         String?
  occurrences       Int      @default(1)
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())

  @@unique([source, externalReference, reasonCode])
  @@index([lastSeenAt])
}

// Stable identity of an Efí bank account in one environment. A PLATFORM
// identity is shared by reference; a COMPANY identity belongs to one tenant.
model EfiAccountIdentity {
  id                  String                  @id @default(uuid())
  ownership           EfiAccountOwnership
  companyId           String?
  company             Company?                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  environment         EfiEnvironment
  holderDocument      String
  efiAccountNumber    String
  efiAccountDigit     String?
  payeeCode           String?
  pixKey              String?
  healthStatus        IntegrationHealthStatus @default(UNKNOWN)
  lastValidatedAt     DateTime?
  consecutiveFailures Int                     @default(0)
  sanitizedLastError  String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  credentialVersions EfiCredentialVersion[]
  financialProfiles  FinancialProfileVersion[]
  paymentCharges     PaymentCharge[]
  gatewayAccount     GatewayAccount?

  @@unique([environment, efiAccountNumber])
  @@unique([id, companyId])
  @@index([companyId])
}

// Encrypted credentials and certificate of an identity. Rotation adds a new
// version for the same identity instead of changing where charges came from.
model EfiCredentialVersion {
  id                           String              @id @default(uuid())
  identityId                   String
  identity                     EfiAccountIdentity  @relation(fields: [identityId], references: [id], onDelete: Restrict)
  version                      Int
  status                       EfiCredentialStatus @default(CANDIDATE)
  encryptedClientId            String              @db.Text
  encryptedClientSecret        String              @db.Text
  encryptedCertificate         String              @db.Text
  encryptedCertificatePassword String?             @db.Text
  credentialKeyVersion         String
  certificateFingerprint       String
  certificateExpiresAt         DateTime
  createdByUserId              String?
  createdByUser                User?               @relation("EfiCredentialCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activatedAt                  DateTime?
  retiredAt                    DateTime?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  financialProfiles FinancialProfileVersion[]
  paymentCharges    PaymentCharge[]

  @@unique([identityId, version])
  @@unique([id, identityId])
}

// Versioned financial configuration of a company. Candidates are edited by
// revision; the published version is referenced by Company.activeFinancialProfileId.
model FinancialProfileVersion {
  id                         String                      @id @default(uuid())
  companyId                  String
  company                    Company                     @relation("CompanyFinancialProfiles", fields: [companyId], references: [id], onDelete: Restrict)
  version                    Int
  revision                   Int                         @default(1)
  status                     FinancialProfileStatus      @default(DRAFT)
  origin                     FinancialActivationOrigin
  accountMode                FinancialAccountMode
  payoutMode                 FinancialPayoutMode
  environment                EfiEnvironment
  enabledMethods             BillingMethod[]
  issuerIdentityId           String?
  issuerIdentity             EfiAccountIdentity?         @relation(fields: [issuerIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuerCredentialVersionId  String?
  issuerCredentialVersion    EfiCredentialVersion?       @relation(fields: [issuerCredentialVersionId, issuerIdentityId], references: [id, identityId], onDelete: Restrict, onUpdate: Restrict)
  authorizationKind          FinancialAuthorizationKind?
  authorizationReference     String?
  authorizationValidUntil    DateTime?
  ownershipVerifiedAt        DateTime?
  ownershipVerifiedByUserId  String?
  ownershipVerifiedByUser    User?                       @relation("FinancialProfileOwnershipVerifiedBy", fields: [ownershipVerifiedByUserId], references: [id], onDelete: Restrict)
  ownershipEvidenceReference String?
  validatedAt                DateTime?
  validationHash             String?
  creationIdempotencyKey     String                      @unique
  activationIdempotencyKey   String?                     @unique
  activatedAt                DateTime?
  activatedByUserId          String?
  activatedByUser            User?                       @relation("FinancialProfileActivatedBy", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  supersededAt               DateTime?
  canceledAt                 DateTime?
  cancelReason               String?
  createdByUserId            String?
  createdByUser              User?                       @relation("FinancialProfileCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  activeForCompany   Company?                     @relation("CompanyActiveFinancialProfile")
  validationAttempts FinancialValidationAttempt[]
  paymentCharges     PaymentCharge[]

  @@unique([companyId, version])
  @@unique([id, companyId])
  @@index([companyId, status])
}

// Durable validation work for one profile revision. Secrets never enter this
// row or its queue job; steps hold sanitized results only.
model FinancialValidationAttempt {
  id                  String                    @id @default(uuid())
  companyId           String
  company             Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  profileId           String
  profile             FinancialProfileVersion   @relation(fields: [profileId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  profileRevision     Int
  credentialVersionId String?
  status              FinancialValidationStatus @default(PENDING)
  idempotencyKey      String                    @unique
  steps               Json?
  attempts            Int                       @default(0)
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  nextRunAt           DateTime?
  validationHash      String?
  sanitizedErrorCode  String?
  validUntil          DateTime?
  requestedByUserId   String?
  requestedByUser     User?                     @relation("FinancialValidationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([profileId, profileRevision])
  @@index([status, nextRunAt])
}

model PlatformIntegrationState {
  id                  String                  @id @default(uuid())
  integration         PlatformIntegration     @unique
  enabled             Boolean                 @default(false)
  healthStatus        IntegrationHealthStatus @default(UNKNOWN)
  pausedAt            DateTime?
  pauseReason         String?                 @db.Text
  lastCheckedAt       DateTime?
  lastHealthyAt       DateTime?
  consecutiveFailures Int                     @default(0)
  sanitizedLastError  String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([healthStatus, updatedAt])
}

model CommunicationConversation {
  id                     String                      @id @default(uuid())
  channel                CommunicationChannel
  recipientHash          String
  recipientEncrypted     String?                     @db.Text
  recipientType          CommunicationRecipientType?
  status                 ConversationStatus          @default(NEW)
  lastInboundAt          DateTime?
  serviceWindowExpiresAt DateTime?
  lastMessagePreview     String?
  unreadCount            Int                         @default(0)
  retentionExpiresAt     DateTime
  recipientAnonymizedAt  DateTime?
  messages               CommunicationMessage[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@unique([channel, recipientHash])
  @@index([status, updatedAt])
  @@index([retentionExpiresAt])
}

model CommunicationMessage {
  id                 String                    @id @default(uuid())
  conversationId     String
  conversation       CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?                  @relation(fields: [companyId], references: [id])
  invoiceId          String?
  invoice            Invoice?                  @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Restrict)
  debtorId           String?
  debtor             Debtor?                   @relation(fields: [debtorId, companyId], references: [id, companyId], onDelete: Restrict)
  direction          MessageDirection
  content            String                    @db.Text
  externalMessageId  String?                   @unique
  status             String?
  readAt             DateTime?
  retentionExpiresAt DateTime
  anonymizedAt       DateTime?
  createdAt          DateTime                  @default(now())

  transportChannelId       String?
  recipientType            CommunicationRecipientType?
  replyToExternalMessageId String?
  messageType              String?
  providerTimestamp        DateTime?
  source                   CommunicationMessageSource          @default(LEGACY)
  attributionMethod        CommunicationAttributionMethod?
  attributionRevision      Int                                 @default(0)
  statusOccurredAt         DateTime?
  outboundIntent           CommunicationOutboundIntent?
  attributionAudits        CommunicationAttributionAudit[]
  attachments              CommunicationAttachment[]
  interactiveReferences    CommunicationInteractiveReference[]

  @@index([conversationId, createdAt])
  @@index([companyId, direction, createdAt])
  @@index([invoiceId])
  @@index([retentionExpiresAt])
  @@index([companyId, conversationId, createdAt, id], map: "CommunicationMessage_tenant_conversation_cursor_idx")
  @@index([companyId, createdAt, id], map: "CommunicationMessage_tenant_cursor_idx")
  @@index([transportChannelId, replyToExternalMessageId], map: "CommunicationMessage_reply_context_idx")
  @@index([conversationId, attributionMethod, direction], map: "CommunicationMessage_classification_idx")
}

/// Server-issued opaque button reference. Only the SHA-256 of the token is stored.
model CommunicationInteractiveReference {
  id          String               @id @default(uuid())
  tokenHash   String               @unique @db.VarChar(64)
  messageId   String
  message     CommunicationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  buttonIndex Int
  createdAt   DateTime             @default(now())

  @@unique([messageId, buttonIndex])
}

model CommunicationWebhookDelivery {
  id                 String                            @id @default(uuid())
  channel            CommunicationChannel              @default(WHATSAPP)
  transport          CommunicationTransport
  transportChannelId String
  deliveryId         String
  bodyHash           String                            @db.VarChar(64)
  payloadEncrypted   String?                           @db.Text
  state              CommunicationDeliveryState        @default(PENDING)
  attempts           Int                               @default(0)
  lastErrorCode      String?                           @db.VarChar(64)
  nextAttemptAt      DateTime                          @default(now())
  leaseExpiresAt     DateTime?
  processedAt        DateTime?
  retentionExpiresAt DateTime
  payloadPurgedAt    DateTime?
  wabaId             String?
  leaseToken         String?
  eventKinds         String[]                          @default([])
  reviewRequired     Boolean                           @default(false)
  replayCount        Int                               @default(0)
  lastReplayedAt     DateTime?
  lastReplayActorId  String?
  statusEvents       CommunicationMessageStatusEvent[]
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt

  @@unique([transport, transportChannelId, deliveryId], map: "CommunicationWebhookDelivery_transport_channel_delivery_key")
  @@index([state, nextAttemptAt])
  @@index([state, leaseExpiresAt])
  @@index([retentionExpiresAt])
  @@index([reviewRequired, createdAt])
}

// Durable status reconciliation also covers webhooks that precede the send response.
model CommunicationRecipientSuppression {
  id            String                     @id @default(uuid())
  channel       CommunicationChannel       @default(WHATSAPP)
  recipientType CommunicationRecipientType
  recipientHash String                     @db.VarChar(64)
  reasonCode    String                     @db.VarChar(64)
  blockedAt     DateTime                   @default(now())

  @@unique([channel, recipientHash])
}

model CommunicationMessageStatusEvent {
  id                 String                       @id @default(uuid())
  eventKey           String                       @unique @db.VarChar(64)
  deliveryId         String
  delivery           CommunicationWebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  externalMessageId  String
  transportChannelId String
  recipientType      CommunicationRecipientType
  recipientHash      String                       @db.VarChar(64)
  status             String                       @db.VarChar(16)
  occurredAt         DateTime
  errorCodes         String[]                     @default([])
  appliedAt          DateTime?
  resolutionCode     String?                      @db.VarChar(64)
  nextAttemptAt      DateTime                     @default(now())
  retentionExpiresAt DateTime
  createdAt          DateTime                     @default(now())

  @@index([appliedAt, nextAttemptAt])
  @@index([externalMessageId, transportChannelId])
  @@index([deliveryId])
  @@index([retentionExpiresAt])
}

model CommunicationOutboundIntent {
  id                 String                     @id @default(uuid())
  idempotencyKey     String                     @unique @db.VarChar(200)
  messageId          String                     @unique
  message            CommunicationMessage       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoiceId          String?
  invoice            Invoice?                   @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Restrict)
  debtorId           String?
  debtor             Debtor?                    @relation(fields: [debtorId, companyId], references: [id, companyId], onDelete: Restrict)
  transport          CommunicationTransport
  transportChannelId String
  recipientType      CommunicationRecipientType
  recipientHash      String                     @db.VarChar(64)
  recipientEncrypted String                     @db.Text
  requestHash        String                     @db.VarChar(64)
  payloadEncrypted   String?                    @db.Text
  state              CommunicationIntentState   @default(PENDING)
  externalMessageId  String?                    @unique
  attempts           Int                        @default(0)
  nextAttemptAt      DateTime                   @default(now())
  leaseToken         String?
  leaseExpiresAt     DateTime?
  quotaReservedAt    DateTime?
  lastErrorCode      String?                    @db.VarChar(64)
  retentionExpiresAt DateTime
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([companyId, createdAt, id])
  @@index([state, createdAt])
  @@index([state, nextAttemptAt])
  @@index([retentionExpiresAt])
}

model CommunicationAttributionAudit {
  id          String                         @id @default(uuid())
  messageId   String
  message     CommunicationMessage           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  actorType   CommunicationActorType
  actorUserId String?
  actorUser   User?                          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  method      CommunicationAttributionMethod
  oldContext  Json
  newContext  Json
  reason      String                         @db.VarChar(500)
  revision    Int
  createdAt   DateTime                       @default(now())

  @@unique([messageId, revision])
  @@index([actorUserId, createdAt])
}

model CommunicationAttachment {
  id                 String                       @id @default(uuid())
  messageId          String
  message            CommunicationMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  externalMediaId    String?
  contentType        String?                      @db.VarChar(255)
  sizeBytes          Int?
  storageKey         String?
  state              CommunicationAttachmentState @default(PENDING)
  retentionExpiresAt DateTime
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  /// Download queue: lease, attempts and a stable local reason when unavailable.
  attempts           Int                          @default(0)
  nextAttemptAt      DateTime                     @default(now())
  leaseToken         String?
  leaseExpiresAt     DateTime?
  errorCode          String?                      @db.VarChar(64)
  sha256             String?                      @db.VarChar(64)
  storedAt           DateTime?

  @@unique([messageId, externalMediaId])
  @@index([state, createdAt])
  @@index([state, nextAttemptAt])
  @@index([retentionExpiresAt])
}

model PaymentNotification {
  id              String                    @id @default(uuid())
  companyId       String
  company         Company                   @relation(fields: [companyId], references: [id])
  invoiceId       String
  invoice         Invoice                   @relation(fields: [invoiceId], references: [id])
  status          PaymentNotificationStatus @default(PENDING)
  recipientEmails String[]                  @default([])
  errorMessage    String?                   @db.Text
  summary         Json
  sentAt          DateTime?
  readAt          DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([companyId, invoiceId])
  @@index([companyId, status, createdAt])
  @@index([invoiceId])
}

model RecurringInvoice {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  debtorId  String
  debtor    Debtor  @relation(fields: [debtorId], references: [id])

  amount                         Decimal                @db.Decimal(10, 2)
  billingType                    BillingMethod
  dueDay                         Int
  status                         RecurringInvoiceStatus @default(ACTIVE)
  lastGeneratedPeriod            String?
  nextDueDate                    DateTime?
  lateFineBasisPoints            Int                    @default(0)
  lateInterestMonthlyBasisPoints Int                    @default(0)
  paymentDaysAfterDue            Int                    @default(30)

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([debtorId])
  @@index([companyId, status])
}

model CollectionLog {
  id          String  @id @default(uuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  actionType  String
  description String
  status      String

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([invoiceId])
  @@index([companyId, actionType, createdAt])
}

model User {
  id                             String                          @id @default(uuid())
  email                          String                          @unique
  password                       String
  name                           String?
  companyId                      String
  company                        Company                         @relation(fields: [companyId], references: [id])
  role                           UserRole                        @default(COMPANY_ADMIN)
  mustChangePassword             Boolean                         @default(false)
  tokenVersion                   Int                             @default(0)
  assignedConversations          WhatsAppConversation[]
  auditLogs                      AuditLog[]
  passwordResetTokens            PasswordResetToken[]
  efiOnboardingConsents          EfiOnboarding[]                 @relation("EfiOnboardingConsentUser")
  createdPaymentFees             PaymentFeeVersion[]             @relation("PaymentFeeCreatedBy")
  createdFinancialProfiles       FinancialProfileVersion[]       @relation("FinancialProfileCreatedBy")
  activatedFinancialProfiles     FinancialProfileVersion[]       @relation("FinancialProfileActivatedBy")
  verifiedFinancialProfiles      FinancialProfileVersion[]       @relation("FinancialProfileOwnershipVerifiedBy")
  createdEfiCredentials          EfiCredentialVersion[]          @relation("EfiCredentialCreatedBy")
  requestedFinancialValidations  FinancialValidationAttempt[]    @relation("FinancialValidationRequestedBy")
  communicationAttributionAudits CommunicationAttributionAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, companyId])
  @@index([companyId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  companyId String
  userId    String
  user      User      @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([companyId, tokenHash])
  @@index([companyId, userId])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  price         Decimal        @db.Decimal(10, 2)
  invoiceLimit  Int
  subscriptions Subscription[]
}

model Subscription {
  id                    String             @id @default(uuid())
  companyId             String             @unique
  company               Company            @relation(fields: [companyId], references: [id])
  planId                String
  plan                  Plan               @relation(fields: [planId], references: [id])
  status                SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd      DateTime
  gatewaySubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MessageTemplate {
  id                    String                        @id @default(uuid())
  name                  String // Nome para o lojista (ex: "Aviso de Vencimento")
  slug                  String // Identificador interno (ex: "vencimento-hoje", "atraso-5-dias")
  content               String                        @db.Text // O texto com Spintax e variáveis
  footerText            String?                       @db.Text
  paymentButtonEnabled  Boolean                       @default(true)
  paymentButtonLabel    String                        @default("Abrir pagamento")
  copyCodeButtonEnabled Boolean                       @default(false)
  copyCodeSource        MessageTemplateCopyCodeSource @default(AUTO)
  isActive              Boolean                       @default(true)
  metaTemplateName      String?
  metaLanguage          String                        @default("pt_BR")
  category              WhatsAppTemplateCategory      @default(UTILITY)
  metaStatus            String                        @default("LOCAL")
  metaRejectedReason    String?                       @db.Text
  lastMetaSyncAt        DateTime?
  companyId             String
  company               Company                       @relation(fields: [companyId], references: [id])
  ruleSteps             CollectionRuleStep[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@unique([companyId, slug])
}

model EmailTemplate {
  id                String    @id @default(uuid())
  name              String
  slug              String
  subject           String
  content           String    @db.Text
  isActive          Boolean   @default(true)
  resendTemplateId  String?
  resendAlias       String?
  resendStatus      String    @default("local")
  resendPublishedAt DateTime?
  lastResendSyncAt  DateTime?
  resendError       String?   @db.Text
  deletedAt         DateTime?
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, deletedAt])
  @@index([resendTemplateId])
}

model GlobalMessageTemplate {
  id                    String                        @id @default(uuid())
  name                  String
  slug                  String                        @unique
  content               String                        @db.Text
  footerText            String?                       @db.Text
  paymentButtonEnabled  Boolean                       @default(true)
  paymentButtonLabel    String                        @default("Abrir pagamento")
  copyCodeButtonEnabled Boolean                       @default(false)
  copyCodeSource        MessageTemplateCopyCodeSource @default(AUTO)
  isActive              Boolean                       @default(true)
  metaTemplateName      String?
  metaLanguage          String                        @default("pt_BR")
  category              WhatsAppTemplateCategory      @default(UTILITY)
  metaStatus            String                        @default("LOCAL")
  metaRejectedReason    String?                       @db.Text
  lastMetaSyncAt        DateTime?
  metaTemplateId        String?
  metaQuality           String?
  metaProviderCategory  String?
  metaComponents        Json?
  metaReviewRequired    Boolean                       @default(false)
  metaStatusAt          DateTime?
  metaQualityAt         DateTime?
  metaCategoryAt        DateTime?
  metaComponentsAt      DateTime?
  preferences           CompanyTemplatePreference[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
}

model GlobalEmailTemplate {
  id                String                      @id @default(uuid())
  name              String
  slug              String                      @unique
  subject           String
  content           String                      @db.Text
  isActive          Boolean                     @default(true)
  resendTemplateId  String?
  resendAlias       String?
  resendStatus      String                      @default("local")
  resendPublishedAt DateTime?
  lastResendSyncAt  DateTime?
  resendError       String?                     @db.Text
  preferences       CompanyTemplatePreference[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([resendTemplateId])
}

model CompanyTemplatePreference {
  id                      String                 @id @default(uuid())
  companyId               String
  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel                 CollectionChannel
  slug                    String
  isActive                Boolean                @default(true)
  greeting                String?                @db.VarChar(80)
  instructions            String?                @db.VarChar(280)
  signature               String?                @db.VarChar(120)
  globalMessageTemplateId String?
  globalMessageTemplate   GlobalMessageTemplate? @relation(fields: [globalMessageTemplateId], references: [id], onDelete: Cascade)
  globalEmailTemplateId   String?
  globalEmailTemplate     GlobalEmailTemplate?   @relation(fields: [globalEmailTemplateId], references: [id], onDelete: Cascade)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([companyId, channel, slug])
  @@index([globalMessageTemplateId])
  @@index([globalEmailTemplateId])
}

model MessagingUsage {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  phoneNumber String
  sentAt      DateTime @default(now())

  @@unique([companyId, phoneNumber])
  @@index([companyId, sentAt])
}

model WhatsAppInteraction {
  id          String                       @id @default(uuid())
  companyId   String
  company     Company                      @relation(fields: [companyId], references: [id])
  phoneNumber String
  direction   WhatsAppInteractionDirection
  status      String?
  messageId   String?
  rawPayload  Json?
  receivedAt  DateTime                     @default(now())

  @@index([companyId, receivedAt])
  @@index([companyId, phoneNumber])
}

model CollectionProfile {
  id             String                @id @default(uuid())
  companyId      String
  company        Company               @relation(fields: [companyId], references: [id])
  name           String
  profileType    CollectionProfileType
  isDefault      Boolean               @default(false)
  isActive       Boolean               @default(true)
  daysOverdueMin Int?
  daysOverdueMax Int?
  steps          CollectionRuleStep[]
  debtors        Debtor[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([companyId, name])
  @@index([companyId, isDefault])
}

model CollectionRuleStep {
  id            String              @id @default(uuid())
  profileId     String
  profile       CollectionProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  stepOrder     Int
  channel       CollectionChannel
  templateId    String?
  template      MessageTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  delayDays     Int                 @default(0)
  sendTimeStart String?
  sendTimeEnd   String?
  isActive      Boolean             @default(true)
  attempts      CollectionAttempt[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([profileId, stepOrder, channel])
  @@index([profileId, stepOrder])
}

model CollectionAttempt {
  id                String                  @id @default(uuid())
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id])
  invoiceId         String
  invoice           Invoice                 @relation(fields: [invoiceId], references: [id])
  ruleStepId        String
  ruleStep          CollectionRuleStep      @relation(fields: [ruleStepId], references: [id])
  channel           CollectionChannel
  status            CollectionAttemptStatus @default(QUEUED)
  externalMessageId String?
  errorDetails      String?                 @db.Text
  createdAt         DateTime                @default(now())

  @@unique([companyId, invoiceId, ruleStepId, channel])
  @@index([companyId, createdAt])
  @@index([invoiceId])
  @@index([externalMessageId])
}

model EmailEvent {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  svixId         String   @unique
  emailMessageId String
  eventType      String
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  recipientEmail String
  rawPayload     Json?
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  @@index([companyId, occurredAt])
  @@index([emailMessageId])
}

model WhatsAppConversation {
  id                     String             @id @default(uuid())
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id])
  debtorId               String?
  debtor                 Debtor?            @relation(fields: [debtorId], references: [id])
  phoneNumber            String
  status                 ConversationStatus @default(NEW)
  assigneeId             String?
  assignee               User?              @relation(fields: [assigneeId], references: [id])
  lastInboundAt          DateTime?
  serviceWindowExpiresAt DateTime?
  lastMessagePreview     String?
  unreadCount            Int                @default(0)
  messages               WhatsAppMessage[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([companyId, phoneNumber])
  @@index([companyId, status, updatedAt])
}

model WhatsAppMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  content        String               @db.Text
  messageId      String?              @unique
  status         String?
  readAt         DateTime?
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

model AuditLog {
  id                 String    @id @default(uuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  action             String
  entityType         String
  entityId           String
  changes            Json?
  userId             String?
  user               User?     @relation(fields: [userId], references: [id])
  createdAt          DateTime  @default(now())
  retentionExpiresAt DateTime?

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@index([retentionExpiresAt])
}
