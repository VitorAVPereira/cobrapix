# ============================================
# API-COBRANCA (NestJS backend)
# ============================================
# Copie para .env e preencha. Não commitar .env com valores reais.

# Ambiente
NODE_ENV=development

# Porta HTTP do Nest (padrão 3001, front-cobranca usa 3000)
PORT=3001
# Quantidade de proxies reversos confiáveis entre o cliente e a API.
# Use 0 em acesso direto; configure conforme a topologia de produção.
TRUST_PROXY_HOPS=0

# ============================================
# PostgreSQL (Docker local - recomendado para desenvolvimento)
# ============================================
# Se usando Docker local (definido no docker-compose.yml)
DATABASE_URL="postgresql://cobrapix:cobrapix_password@localhost:5432/cobrapix"
# URL direta para Prisma (sem pool de conexão)
DIRECT_URL="postgresql://cobrapix:cobrapix_password@localhost:5432/cobrapix"

# Variáveis do Docker (opcional - para docker-compose)
# POSTGRES_USER=cobrapix
# POSTGRES_PASSWORD=cobrapix_password
# POSTGRES_DB=cobrapix

# ============================================
# Meta Cloud API (WhatsApp oficial)
# ============================================
# Canal central CifraMais; segredos somente no servidor.
# O webhook oficial deve apontar para: https://sua-api.com/webhooks/meta
META_GRAPH_API_VERSION="v23.0"
META_WEBHOOK_VERIFY_TOKEN="change_me_meta_verify_token"
META_WEBHOOK_BASE_URL="https://your-public-api-url.com"
META_APP_SECRET="your_meta_app_secret"
META_ACCESS_TOKEN="your_central_meta_token"
META_PHONE_NUMBER_ID="your_central_phone_number_id"
META_BUSINESS_ACCOUNT_ID="your_central_waba_id"
META_BUSINESS_PHONE_NUMBER="5511999999999"
META_DEFAULT_LANGUAGE="pt_BR"

# Evolution API legado (opcional, mantido apenas para migração)
# EVOLUTION_API_URL="http://localhost:8080"
# EVOLUTION_API_KEY="evolution_api_key_secret_change_in_production"
# EVOLUTION_JWT_SECRET="jwt_secret_change_in_production"

# ============================================
# Efi Bank (Gateway de Pagamento - PIX CobV/Bolix)
# ============================================
EFI_ENV="homologation"
EFI_PLATFORM_CLIENT_ID="your_efi_platform_client_id"
EFI_PLATFORM_CLIENT_SECRET="your_efi_platform_client_secret"
EFI_PLATFORM_CERT_PATH="C:\\certs\\efi-homologacao.p12"
EFI_PLATFORM_CERT_PASSWORD="your_efi_certificate_password"
EFI_PLATFORM_PAYEE_CODE="your_platform_payee_code"
EFI_PLATFORM_ACCOUNT_NUMBER="your_platform_account_number"
EFI_PLATFORM_CNPJ="00000000000000"
EFI_PLATFORM_SPLIT_PERCENTAGE=0
EFI_WEBHOOK_BASE_URL="https://your-public-api-url.com"
EFI_WEBHOOK_SECRET="change_me_with_at_least_32_characters"
PAYMENT_SECRET_KEY="change_me_with_at_least_32_characters"
# Gere chaves aleatórias reais de 32 bytes (hex de 64 caracteres ou base64).
# PAYMENT_SECRET_KEY é somente compatibilidade para dados legados.
# PAYMENT_ENCRYPTION_KEYS='{"v1":"<64-hex-characters>"}'
# PAYMENT_ACTIVE_KEY_VERSION="v1"
# Rotação: npm run payment:rotate-keys (simulação); acrescente -- --apply para gravar.

# API Abertura de Contas — aplicação integradora habilitada pela Efí.
# A pausa operacional persiste no banco e começa desligada.
EFI_OPENING_CLIENT_ID="your_opening_client_id"
EFI_OPENING_CLIENT_SECRET="your_opening_client_secret"
EFI_OPENING_CERT_PATH="/run/secrets/efi-integrator.p12"
EFI_OPENING_CERT_PASSWORD=""
EFI_ONBOARDING_NOTICE_TEMPLATE="ciframais_efi_autorizacao"
EFI_ONBOARDING_REMINDER_TEMPLATE="ciframais_efi_lembrete"
EFI_ONBOARDING_AUTHORIZATION_VERSION="draft-v1"
EFI_ONBOARDING_TERMS_VERSION="draft-v1"
EFI_ONBOARDING_PRIVACY_VERSION="draft-v1"
# Endereço EXATO do proxy interno que autentica mTLS; nunca usar IP do visitante.
# EFI_MTLS_PROXY_IP="172.30.0.2"
PLATFORM_ALERT_EMAIL="operacoes@example.com"

# ============================================
# Redis (para filas BullMQ)
# ============================================
# Instância Redis para filas de mensagens (use Docker, Upstash, etc)
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_PASSWORD="your_redis_password"  # opcional

# ============================================
# Resend (e-mail de cobrança)
# ============================================
# Conta, domínio verificado, remetente e atendimento centrais CifraMais.
RESEND_API_KEY="re_your_central_api_key"
RESEND_FROM_EMAIL="CifraMais <cobranca@example.com>"
RESEND_REPLY_TO="suporte@example.com"
# Cadastre no Resend Dashboard um webhook apontando para:
#   https://sua-api.com/webhooks/resend
# Eventos recomendados:
#   email.sent, email.delivered, email.opened, email.clicked,
#   email.bounced, email.complained, email.failed, email.suppressed,
#   email.delivery_delayed
# Copie o signing secret do endpoint de webhook no Resend Dashboard.
RESEND_WEBHOOK_SECRET="whsec_replace_with_central_signing_secret"

# ============================================
# Autenticação
# ============================================
JWT_SECRET="your_jwt_secret_with_at_least_32_characters"
# URL pública exata do frontend usada nos links de recuperação.
# Em produção é obrigatória e deve começar com https://.
FRONTEND_URL="http://localhost:3000"
# Credenciais transacionais da plataforma para recuperação de senha.
AUTH_RESEND_API_KEY="re_test"
AUTH_EMAIL_FROM="CobraPix <acesso@ciframais.com.br>"

# ============================================
# CORS
# ============================================
# Frontend URLs separadas por vírgula
ALLOWED_ORIGINS="http://localhost:3000"
